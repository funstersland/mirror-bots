# Port the app listens on
PORT=8080
# Secret for signing login cookies. Set a long random string in production.
JWT_SECRET=
# Where SQLite lives
DB_PATH=./data/polybots.db
# binance = real BTCUSDT 1h candles (what Polymarket hourly BTC markets settle on)
# sim     = synthetic candles, for offline development only
DATA_SOURCE=binance
# Polymarket taker fee rate applied as C*rate*p*(1-p). 0 = maker-style fills (no fee).
TAKER_FEE_RATE=0
# Allow new accounts (set to false after you sign up)
ALLOW_SIGNUP=true
